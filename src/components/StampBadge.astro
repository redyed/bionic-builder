---
interface Props {
  text: string;
  subline?: string;
  animate?: boolean;
  class?: string;
}

const { text, subline, animate = false, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "inline-block -rotate-[4deg] border-2 border-stamp px-4 py-2 text-center",
    animate && "stamp-animate",
    className,
  ]}
  style="box-shadow: 1px 1px 0 rgba(194, 47, 42, 0.15), -0.5px -0.5px 0 rgba(194, 47, 42, 0.08);"
>
  <span class="font-display text-sm font-black uppercase tracking-wider text-stamp">{text}</span>
  {subline && (
    <p class="mt-1 font-body text-sm text-muted">{subline}</p>
  )}
</div>
