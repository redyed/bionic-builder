---
import StampBadge from "./StampBadge.astro";
---

<footer class="wide-width mx-auto px-6 pb-16 pt-12">
  <div class="section-rule pt-12">
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-end md:justify-between">
      <p class="font-body text-base text-muted">
        Deyder Cintron ·
        <a href="https://x.com/deydercintron" class="text-ink underline decoration-rule underline-offset-4 hover:text-stamp hover:decoration-stamp">
          X @deydercintron
        </a>
        · Music:
        <a href="https://deydercintron.com" class="text-ink underline decoration-rule underline-offset-4 hover:text-stamp hover:decoration-stamp">
          deydercintron.com
        </a>
      </p>
      <StampBadge
        text="Built by the org"
        subline="This site was built by the org it describes."
      />
    </div>
  </div>
</footer>
