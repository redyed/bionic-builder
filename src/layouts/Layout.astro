---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  ogImage = "/images/og-home.png",
  schema,
} = Astro.props;

const siteUrl = Astro.site ?? "https://thebionicbuilder.com";
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(pathname, siteUrl).href;
const fullOgImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Bionic Builder" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@deydercintron" />
    <meta name="twitter:creator" content="@deydercintron" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(
          Array.isArray(schema)
            ? { "@context": "https://schema.org", "@graph": schema }
            : { "@context": "https://schema.org", ...schema }
        )}
      />
    )}
  </head>
  <body>
    <canvas id="page-rain" aria-hidden="true" transition:persist></canvas>
    <p id="page-route-log" aria-hidden="true" transition:persist></p>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/btn-primary-sheen.ts";
      import "../scripts/telemetry-count.ts";
      import "../scripts/page-rain.ts";
    </script>
  </body>
</html>
