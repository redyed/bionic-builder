---
interface Props {
  label: string;
  value?: string;
  muted?: boolean;
  href?: string;
}

const { label, value, muted = false, href } = Astro.props;
---

<div class:list={["section-rule flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between", muted && "text-muted"]}>
  <span class="font-body text-lg">
    {href ? (
      <a href={href} class="text-ink underline decoration-rule underline-offset-4 hover:text-stamp hover:decoration-stamp">
        {label}
      </a>
    ) : (
      label
    )}
  </span>
  {value && (
    <span class="font-data shrink-0 text-base sm:text-right">{value}</span>
  )}
</div>
