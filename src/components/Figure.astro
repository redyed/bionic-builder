---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
  caption?: string;
  figureClass?: string;
  imgClass?: string;
  imgStyle?: string;
  framed?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  caption,
  figureClass,
  imgClass = "block h-auto w-full",
  imgStyle,
  framed = false,
} = Astro.props;
---

<figure class={figureClass}>
  <div class:list={[framed && "panel overflow-hidden p-0"]}>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      class:list={[imgClass, framed && "rounded-[7px]"]}
      style={imgStyle}
    />
  </div>
  {caption && (
    <figcaption class="mt-2 text-center font-body text-sm text-dim">
      {caption}
    </figcaption>
  )}
</figure>
