---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const onSetups = currentPath === "/setups" || currentPath.startsWith("/setups/");
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-panel focus:px-4 focus:py-2 focus:text-starlight">
  Skip to content
</a>

<header class="wide-width mx-auto px-6 py-8">
  <nav class="flex items-center justify-between" aria-label="Main">
    <a href="/" class="shrink-0 no-underline hover:opacity-80">
      <img
        src="/images/logo-nav.png"
        alt="Bionic Builder"
        width={500}
        height={115}
        class="h-11 w-auto"
        loading="eager"
        transition:name="logo"
        transition:persist
      />
    </a>
    <ul class="flex gap-8">
      <li>
        <a
          href="/setups"
          class:list={[
            "font-display text-sm font-extrabold uppercase tracking-wider no-underline hover:opacity-80",
            currentPath === "/setups" || onSetups ? "text-starlight" : "text-dim",
          ]}
        >
          Setups
        </a>
      </li>
      <li>
        <a
          href="/now"
          class:list={[
            "font-display text-sm font-extrabold uppercase tracking-wider no-underline hover:opacity-80",
            currentPath === "/now" ? "text-starlight" : "text-dim",
          ]}
        >
          Now
        </a>
      </li>
    </ul>
  </nav>
</header>
