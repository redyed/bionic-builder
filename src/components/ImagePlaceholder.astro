---
interface Props {
  label: string;
  file: string;
  aspectRatio?: string;
  alt?: string;
  founderSupplied?: boolean;
  founderLabel?: string;
  showCaption?: boolean;
  caption?: string;
  ext?: "png" | "webp";
  fit?: "cover" | "contain";
  /** CSS display width — use with height for HiDPI (2× asset at half logical size). */
  width?: number;
  height?: number;
  class?: string;
}

const {
  label,
  file,
  aspectRatio = "16 / 10",
  alt = "",
  founderSupplied = false,
  founderLabel,
  showCaption = false,
  caption = "",
  ext = founderSupplied ? "webp" : "png",
  fit = "cover",
  width,
  height,
  class: className = "",
} = Astro.props;

const imagePath = `/images/${file}.${ext}`;
const displayLabel = founderLabel ?? (founderSupplied
  ? "REAL SCREENSHOT — founder supplies. No mockups, no generated dashboards."
  : label);
const fixedSize = width != null && height != null;
const fixedSizeStyle = fixedSize ? `width: ${width}px; height: ${height}px;` : undefined;
---

<figure class:list={[fixedSize ? "mx-auto flex w-fit shrink-0 flex-col items-center" : fit === "contain" ? "w-fit" : "w-full", className]}>
  <div
    class:list={[
      "image-frame relative flex items-center justify-center border border-dashed border-rule bg-paper",
      fit === "cover" ? "w-full overflow-hidden" : fixedSize ? "shrink-0" : width ? "w-fit" : "w-full",
    ]}
    style={fit === "cover" ? `aspect-ratio: ${aspectRatio};` : fixedSizeStyle}
  >
    <img
      src={imagePath}
      alt={alt}
      width={width}
      height={height}
      class:list={[
        fit === "cover"
          ? "absolute inset-0 h-full w-full object-cover object-top"
          : fixedSize
            ? "block shrink-0 object-contain"
            : width
              ? "block h-auto w-auto max-w-full"
              : "block h-auto w-full max-w-full",
      ]}
      style={fixedSize ? fixedSizeStyle : undefined}
      onload="this.nextElementSibling?.classList.add('hidden'); this.closest('.image-frame')?.classList.remove('border-dashed');"
      onerror="this.style.display='none'"
    />
    <span class="font-data relative z-10 px-4 text-center text-xs text-muted">{displayLabel}</span>
  </div>
  {showCaption && (
    <figcaption class="mt-2 text-center font-body text-sm text-muted">
      {caption}
    </figcaption>
  )}
</figure>
