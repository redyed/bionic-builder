---
import Layout from "../layouts/Layout.astro";
import Aurora from "../components/Aurora.astro";
import Atmosphere from "../components/Atmosphere.astro";
import GateLight from "../components/GateLight.astro";
import BootHeadline from "../components/BootHeadline.astro";
import Figure from "../components/Figure.astro";
import LedgerRow from "../components/LedgerRow.astro";
import EmailBlock from "../components/EmailBlock.astro";

const schema = [
  {
    "@type": "WebSite",
    "@id": "https://thebionicbuilder.com/#website",
    "url": "https://thebionicbuilder.com",
    "name": "Bionic Builder",
    "description": "Publications, courses, and software shipped by an AI-employee org — no headcount, about $170 a month.",
    "publisher": {
      "@type": "Person",
      "@id": "https://thebionicbuilder.com/#founder",
      "name": "Deyder Cintron",
      "url": "https://deydercintron.com",
      "sameAs": [
        "https://x.com/deydercintron"
      ],
      "jobTitle": "Producer & Founder"
    }
  },
  {
    "@type": "Organization",
    "@id": "https://thebionicbuilder.com/#organization",
    "name": "Bionic Builder",
    "url": "https://thebionicbuilder.com",
    "logo": "https://thebionicbuilder.com/images/og-home.png",
    "founder": {
      "@id": "https://thebionicbuilder.com/#founder"
    },
    "description": "An autonomous AI-employee organization operating publishing, courses, and software pipelines."
  }
];
---

<Layout
  title="Bionic Builder — Run your company on AI employees"
  description="Publications, courses, and software shipped by an AI-employee org — no headcount, about $170 a month. Built and signed by producer Deyder Cintron."
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <Aurora
      intensity="full"
      variant="balanced"
      backdrop="/images/hero-backdrop.webp"
      backdropPosition="center 42%"
    />

    <div class="wide-width relative mx-auto px-6 pb-20 pt-4">
      <p class="eyebrow hud-enter hud-d1" data-decode>Bionic Builder</p>
      <BootHeadline
        text="Your company runs while the laptop is closed."
        class="mt-5 max-w-3xl font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-starlight sm:text-5xl lg:text-6xl"
      />
      <p class="prose-lead-lg hud-enter hud-d3 mt-6 max-w-2xl">
        AI employees ship the publications, courses, and software.<br />
        No staff.
      </p>
      <p class="prose-dim hud-enter hud-d4 mt-3">
        You keep the judgment.
      </p>
      <div class="hud-enter hud-d5 mt-8 flex flex-wrap items-center gap-6">
        <a href="/setups" class="btn-primary">
          Read the setups
        </a>
        <GateLight label="Signed · D.C." />
      </div>

      <p class="prose-dim prose-width hud-enter hud-d6 mt-12">
        Built and run by Deyder Cintron — producer, <span class="telemetry" data-count="4" data-count-suffix="×" data-count-delay="1400">4×</span> Grammy-nominated records, <span class="telemetry" data-count="2.2" data-count-decimals="1" data-count-suffix="B" data-count-delay="1520">2.2B</span> streams. The org ships the companies. He signs what can be quoted.
      </p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section-rule wide-width mx-auto px-6 py-16">
    <div class="prose-width">
      <p class="eyebrow">Who it's for</p>
      <p class="prose-lead mt-6">
        For people who already make the work — a magazine, a practice, a product — and are done being the bottleneck.
      </p>
      <p class="prose-lead mt-4">
        If you only make prompts, this isn't for you. If you have to ship an issue, a cohort, or a tool on Tuesday, it is.
      </p>
    </div>
  </section>

  <!-- What the employees are for -->
  <section class="wide-width mx-auto px-6 py-16">
    <div class="grid gap-6 md:grid-cols-3">
      <article class="panel panel-glass reveal-on-scroll overflow-hidden" style="--reveal-delay: 0ms">
        <img
          src="/images/card-publish.webp"
          alt=""
          width={1024}
          height={576}
          loading="lazy"
          class="cinematic-img card-cinematic"
        />
        <div class="p-6 pt-5">
          <h2 class="font-display text-xl font-extrabold uppercase tracking-wide text-starlight">Publish</h2>
          <p class="mt-3">
            Issues, posts, and pages that go live. Not drafts that die in a folder.
          </p>
        </div>
      </article>

      <article class="panel panel-glass reveal-on-scroll overflow-hidden" style="--reveal-delay: 90ms">
        <img
          src="/images/card-product.webp"
          alt=""
          width={1024}
          height={576}
          loading="lazy"
          class="cinematic-img card-cinematic"
        />
        <div class="p-6 pt-5">
          <h2 class="font-display text-xl font-extrabold uppercase tracking-wide text-starlight">Product</h2>
          <p class="mt-3">
            Courses, waitlists, and software people can actually use.
          </p>
        </div>
      </article>

      <article class="panel panel-glass reveal-on-scroll overflow-hidden" style="--reveal-delay: 180ms">
        <img
          src="/images/card-operate.webp"
          alt=""
          width={1024}
          height={576}
          loading="lazy"
          class="cinematic-img card-cinematic"
        />
        <div class="p-6 pt-5">
          <h2 class="font-display text-xl font-extrabold uppercase tracking-wide text-starlight">Operate</h2>
          <p class="mt-3">
            Research, design, handoffs — so you're not the paste layer between models.
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- The shop floor -->
  <section class="section-rule relative overflow-hidden">
    <Atmosphere variant="violet-heavy" />

    <div class="wide-width relative mx-auto px-6 py-16">
    <div class="prose-width reveal-on-scroll">
      <p class="eyebrow">The shop floor</p>
      <p class="prose-lead mt-6">
        Not a prompt library. An organization — <span class="telemetry" data-count="31" data-count-suffix=" seats">31 seats</span> across <span class="telemetry" data-count="10">10</span> AI labs, run like a company because it is one.
      </p>
    </div>

    <figure class="shopfloor-frame mt-10">
      <div class="shopfloor">
        <img
          src="/images/shopfloor.webp"
          alt="Rows of automated workstations receding into a dark factory floor, lit by violet and cyan."
          width={1024}
          height={576}
          loading="lazy"
          class="shopfloor-img"
        />
        <span class="shopfloor-beam" aria-hidden="true"></span>
      </div>
    </figure>

    <div class="mt-10 max-w-3xl">
      <div class="section-rule py-4">
        Approval gates on send, spend, and publish — nothing irreversible happens without a human.
      </div>
      <div class="section-rule py-4">
        A value ledger — every week, what shipped and what it was worth, in numbers.
      </div>
      <div class="section-rule py-4">
        An auditor that never shares a lab with the work it audits.
      </div>
      <div class="section-rule py-4">
        Done = a URL — a file nobody was told about does not count.
      </div>
    </div>

    <div class="panel relative mt-12 max-w-3xl p-8">
      <GateLight label="Reviewed" class="mb-5" />
      <blockquote class="prose-lead">
        "The system assumes agents fail. The gates exist so failures die in review, not in public."
      </blockquote>
    </div>

    <p class="prose-dim prose-width mt-8">
      Every rule in this shop is a tombstone — sessions rot, ghost profiles respawn, and the rules exist because something broke.
    </p>
    </div>
  </section>

  <!-- Receipts -->
  <section class="section-rule wide-width mx-auto px-6 py-16">
    <p class="eyebrow">Receipts</p>

    <div class="mt-8 max-w-3xl">
      <LedgerRow
        index={0}
        label="The Sovereign Producer — a magazine that publishes"
        labelHref="https://thesovereignproducer.com"
        suffix="— that operation is Setup №2"
        suffixHref="/setups/the-magazine-that-publishes-itself"
      />
      <LedgerRow
        index={1}
        label="Tracked Vocals — a working directory, built in 4 days"
        labelHref="https://trackedvocals.com"
        suffix="— that build is Setup №1"
        suffixHref="/setups/done-is-a-url"
        value="4 days"
        countTo={4}
        countSuffix=" days"
      />
      <LedgerRow
        index={2}
        label="The whole org"
        value="≈ $170 / month"
        countTo={170}
        countPrefix="≈ $"
        countSuffix=" / month"
      />
      <LedgerRow
        index={3}
        label="The older receipts — 4× Grammy-nominated records · 2.2B streams"
        muted={true}
      />
    </div>

    <div class="mt-12 flex justify-center">
      <Figure
        src="/images/receipt-real.webp"
        alt="MUSO.AI profile summary showing 210 production credits and top tracks for Deyder Cintron."
        width={409}
        height={512}
        imgClass="block shrink-0 object-contain"
        imgStyle="width: 409px; height: 512px;"
        figureClass="mx-auto flex w-fit flex-col items-center"
        caption="MUSO.AI credits — 210 credits, 96% above industry average."
        framed={true}
      />
    </div>
  </section>

  <!-- The setups -->
  <section class="section-rule setups-cinematic relative overflow-hidden">
    <Atmosphere
      variant="balanced"
      backdrop="/images/setups-backdrop.webp"
      backdropPosition="center 38%"
      backdropOpacity={0.46}
      prominent={true}
    />

    <div class="wide-width relative mx-auto flex min-h-[inherit] items-center px-6 py-20 md:py-24">
    <div class="prose-width reveal-on-scroll">
      <h2 class="font-display text-3xl font-extrabold uppercase tracking-wide text-starlight">The setups</h2>
      <p class="prose-lead mt-6">
        Every setup used to run the shop. Jobs, handoffs, what breaks, and what never gets handed to a bot.
      </p>
      <p class="prose-lead mt-6">
        I moved in early and kept the receipts. Come look.
      </p>
      <a href="/setups" class="btn-primary mt-8">
        Read the setups
      </a>
    </div>
    </div>
  </section>

  <EmailBlock />
</Layout>

<script>
  import "../scripts/reveal-on-scroll.ts";
  import "../scripts/shopfloor-scroll.ts";
</script>
